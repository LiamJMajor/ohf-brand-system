{
  "$schema": "brand-system/tokens",
  "project": "home-assistant",
  "source": "https://github.com/home-assistant/frontend/tree/dev/src/resources/theme",
  "draft": true,
  "color": {
    "primary": "#009ac7",
    "brand": "#18bcf2",
    "primary-dark": "#006787",
    "primary-light": "#37c8fd",
    "primary-pale": "#b9e6fc",
    "accent": "#ff9800",
    "text": "#141414",
    "text-secondary": "#5e5e5e",
    "text-disabled": "#989898",
    "surface": "#ffffff",
    "surface-low": "#f3f3f3",
    "surface-lower": "#e6e6e6",
    "error": "#db4437",
    "warning": "#ffa600",
    "success": "#43a047",
    "info": "#039be5",
    "dark": {"background": "#111111", "card": "#1c1c1c", "text": "#e1e1e1", "text-secondary": "#9b9b9b"}
  },
  "type": {
    "heading": {"family": "Roboto", "fallback": ["Noto", "sans-serif"], "weights": [700]},
    "body": {"family": "Roboto", "fallback": ["Noto", "sans-serif"], "weights": [300, 400, 500]},
    "longform": {"family": "ui-sans-serif", "fallback": ["system-ui", "sans-serif"]},
    "code": {"family": "monospace"},
    "scale_px": {"xs": 10, "s": 12, "m": 14, "l": 16, "xl": 20, "2xl": 24, "3xl": 28, "4xl": 32, "5xl": 40},
    "line_height": {"condensed": 1.2, "normal": 1.6, "expanded": 2}
  },
  "space": {"unit": 8}
}
